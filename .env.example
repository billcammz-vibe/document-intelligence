# ---------------------------------------------------------------------------
# Copy this file to `.env.local` and fill in the values.
# ---------------------------------------------------------------------------

# Postgres connection string (must be a pgvector-capable Postgres).
# Local dev with Postgres.app:
DATABASE_URL="postgresql://john@localhost:5432/document_intelligence"
# Local dev with the bundled docker-compose:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/document_intelligence"
# Production (Supabase): use the "Connection string" from Project Settings > Database.
# DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres"

# Anthropic — used for answer generation with citations.
ANTHROPIC_API_KEY="sk-ant-..."
# Optional: override the model (defaults to claude-sonnet-5).
# ANTHROPIC_MODEL="claude-sonnet-5"

# Embeddings provider: "voyage" (default) or "openai".
EMBEDDING_PROVIDER="voyage"

# Voyage AI — https://dashboard.voyageai.com/
VOYAGE_API_KEY="pa-..."
# Model + dimension must agree with the pgvector column (see db/migrations).
# voyage-3.5 -> 1024, voyage-finance-2 -> 1024, voyage-3-large -> 1024
EMBEDDING_MODEL="voyage-3.5"
EMBEDDING_DIMENSIONS="1024"

# OpenAI — only needed if EMBEDDING_PROVIDER="openai"
# OPENAI_API_KEY="sk-..."
# EMBEDDING_MODEL="text-embedding-3-small"
# EMBEDDING_DIMENSIONS="1536"

# Retrieval tuning (optional)
# RETRIEVAL_TOP_K="8"
# CHUNK_SIZE="1000"
# CHUNK_OVERLAP="150"
